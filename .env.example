# Gmail SMTP Configuration for Diploma Study Hub
# -------------------------------------------------------------
# 1. Enable 2-Step Verification in your Google Account:
#    https://myaccount.google.com/security
# 2. Generate a 16-character App Password at:
#    https://myaccount.google.com/apppasswords
# 3. Copy this file to '.env' in this same directory and replace
#    'your_16_char_app_password' below with your 16-character code.
# -------------------------------------------------------------

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=sandeshbhivase96@gmail.com
EMAIL_HOST_PASSWORD=your_16_char_app_password
DEFAULT_FROM_EMAIL=sandeshbhivase96@gmail.com
CONTACT_ADMIN_EMAIL=sandeshbhivase96@gmail.com
